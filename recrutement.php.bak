<?php
// 2JK Services — Page Recrutement (additif). URL : /recrutement.php
$page = 'recrutement';
$success = false; $errors = [];
$old = ['fullname'=>'','email'=>'','phone'=>'','poste'=>'','ville'=>'','dispo'=>'','message'=>''];
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    foreach (array_keys($old) as $k) $old[$k] = trim($_POST[$k] ?? '');
    $consent = isset($_POST['consent']);
    if (mb_strlen($old['fullname']) < 2) $errors['fullname'] = 'Veuillez indiquer votre nom complet.';
    if (!filter_var($old['email'], FILTER_VALIDATE_EMAIL)) $errors['email'] = 'E-mail invalide.';
    if (!preg_match('/^[0-9+\s().-]{7,20}$/', $old['phone'])) $errors['phone'] = 'Telephone invalide.';
    if ($old['poste'] === '') $errors['poste'] = 'Choisissez un poste.';
    if (!$consent) $errors['consent'] = 'Vous devez accepter le traitement de votre candidature.';
    $cvName = null;
    if (!empty($_FILES['cv']['name'])) {
        if ($_FILES['cv']['error'] !== UPLOAD_ERR_OK) $errors['cv'] = 'Erreur envoi CV.';
        else {
            if ($_FILES['cv']['size'] > 5*1024*1024) $errors['cv'] = 'CV trop lourd (max 5 Mo).';
            $ext = strtolower(pathinfo($_FILES['cv']['name'], PATHINFO_EXTENSION));
            if (!in_array($ext, ['pdf','doc','docx'], true)) $errors['cv'] = 'Format accepte : PDF, DOC, DOCX.';
            else {
                $dir = __DIR__ . '/uploads/cv';
                if (!is_dir($dir)) @mkdir($dir, 0755, true);
                $cvName = date('Ymd-His') . '-' . preg_replace('/[^A-Za-z0-9._-]/', '_', basename($_FILES['cv']['name']));
                if (empty($errors) && !@move_uploaded_file($_FILES['cv']['tmp_name'], $dir.'/'.$cvName)) $errors['cv'] = 'Impossible d enregistrer le CV.';
            }
        }
    }
    if (empty($errors)) {
        try {
            $dsn = getenv('DB_DSN') ?: '';
            if ($dsn !== '') {
                $pdo = new PDO($dsn, getenv('DB_USER') ?: '', getenv('DB_PASS') ?: '', [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
                $st = $pdo->prepare("INSERT INTO recrutement_candidatures (fullname, email, phone, poste, ville, dispo, message, cv_file) VALUES (?,?,?,?,?,?,?,?)");
                $st->execute([$old['fullname'],$old['email'],$old['phone'],$old['poste'],$old['ville'],$old['dispo'],$old['message'],$cvName]);
            }
        } catch (Throwable $e) {}
        $rh = getenv('RECRUTEMENT_EMAIL') ?: '';
        if ($rh !== '' && filter_var($rh, FILTER_VALIDATE_EMAIL)) {
            @mail($rh, '[2JK Recrutement] '.$old['poste'].' — '.$old['fullname'], "Nom: {$old['fullname']}\nEmail: {$old['email']}\nTel: {$old['phone']}\nPoste: {$old['poste']}\nVille: {$old['ville']}\nDispo: {$old['dispo']}\nMessage: {$old['message']}\nCV: ".($cvName ?? 'non fourni'));
        }
        $success = true;
        $old = ['fullname'=>'','email'=>'','phone'=>'','poste'=>'','ville'=>'','dispo'=>'','message'=>''];
    }
}
function e($s){ return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); }
?>
